{
  "name": "gbdt_mkt",
  "uses_market_features": true,
  "family": "histogram gradient-boosted decision trees (multiclass)",
  "backend": "sklearn_hgb",
  "n_estimators": 300,
  "learning_rate": 0.03,
  "max_depth": 4,
  "features": [
    "elo_home",
    "elo_away",
    "elo_diff",
    "elo_exp_home",
    "home_rest_days",
    "away_rest_days",
    "home_matches_last_14d",
    "away_matches_last_14d",
    "away_fatigue_index",
    "h_gf_r5",
    "h_ga_r5",
    "h_pts_r5",
    "h_gf_r10",
    "h_ga_r10",
    "h_pts_r10",
    "a_gf_r5",
    "a_ga_r5",
    "a_pts_r5",
    "a_gf_r10",
    "a_ga_r10",
    "a_pts_r10",
    "form_diff_r5",
    "attack_diff_r5",
    "defence_diff_r5",
    "form_diff_r10",
    "attack_diff_r10",
    "defence_diff_r10",
    "h_n_prior",
    "a_n_prior",
    "league_id",
    "mkt_home_p",
    "mkt_draw_p",
    "mkt_away_p",
    "mkt_overround"
  ],
  "leakage_checks": [
    "all rolling features shifted by one match",
    "Elo computed sequentially pre-match",
    "closing odds never used; early odds only in *_mkt variant"
  ]
}