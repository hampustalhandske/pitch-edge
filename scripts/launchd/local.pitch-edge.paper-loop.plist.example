<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.pitch-edge.paper-loop</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__REPO_DIR__/.worktrees/scheduled/scripts/paper_loop.sh</string></array>
  <!-- Runs the committed code pinned in .worktrees/scheduled (scripts/scheduled_pin.sh <sha>); data and .env stay in
       the main checkout. -->
  <key>WorkingDirectory</key><string>__REPO_DIR__/.worktrees/scheduled</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PITCH_EDGE_DATA_DIR</key><string>__REPO_DIR__/data</string>
    <key>PITCH_EDGE_ENV_FILE</key><string>__REPO_DIR__/.env</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__REPO_DIR__/data/logs/paper_loop.launchd.log</string>
  <key>StandardErrorPath</key><string>__REPO_DIR__/data/logs/paper_loop.launchd.log</string>
</dict>
</plist>
