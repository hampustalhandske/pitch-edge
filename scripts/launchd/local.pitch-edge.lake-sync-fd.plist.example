<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.pitch-edge.lake-sync-fd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string><string>-i</string>
    <string>/bin/bash</string><string>__REPO_DIR__/.worktrees/scheduled/scripts/lake_sync_fd.sh</string>
  </array>
  <!-- Runs the committed code pinned in .worktrees/scheduled (scripts/scheduled_pin.sh <sha>); data and .env stay in
       the main checkout. -->
  <key>WorkingDirectory</key><string>__REPO_DIR__/.worktrees/scheduled</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PITCH_EDGE_DATA_DIR</key><string>__REPO_DIR__/data</string>
    <key>PITCH_EDGE_ENV_FILE</key><string>__REPO_DIR__/.env</string>
  </dict>
  <!-- The lake fetches football-data daily at about 11:00 UTC. StartCalendarInterval is LOCAL time: 14:00 is 12:00 UTC
       in Europe/Stockholm summer time (13:00 UTC in winter). The second start retries a run that found the warehouse busy.
       Move both hours if the Mac is in another zone; keep the first at or after 12:00 UTC. A start missed while the Mac
       slept runs once on wake. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__REPO_DIR__/data/logs/lake_sync_fd.launchd.log</string>
  <key>StandardErrorPath</key><string>__REPO_DIR__/data/logs/lake_sync_fd.launchd.log</string>
</dict>
</plist>
